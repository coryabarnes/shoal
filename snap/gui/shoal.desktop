[Desktop Entry]
Type=Application
Name=Shoal
GenericName=Drag-and-Drop Shelf
Comment=Keep files, snippets and images close at hand
Exec=shoal
Icon=${SNAP}/meta/gui/shoal.png
Categories=Utility;
Keywords=clipboard;shelf;files;drag;drop;
StartupNotify=false
StartupWMClass=shoal_io.github.coryabarnes.Shoal

# snapd uses the app-named desktop ID to identify portal requests.
NoDisplay=true
